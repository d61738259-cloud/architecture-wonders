# ==========================================
# ARCHITECTURE WONDERS - BACKEND CONFIGURATION
# ==========================================

# Server Port & Environment
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection
# Obtain from MongoDB Atlas -> Database -> Connect -> Drivers (Node.js)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/architecture_wonders?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random 32+ character string)
JWT_SECRET=replace_with_a_secure_random_32_char_secret_key
JWT_EXPIRES_IN=7d

# Frontend Deployment URL (CORS allowed origin)
FRONTEND_URL=https://your-architecture-wonders-site.netlify.app

# Cloudinary Image CDN (Media Library & Portfolio Photographs)
# Obtain from Cloudinary Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# WhatsApp Business Cloud API (For automated lead notifications to studio)
# Official Architecture Wonders number: +91 6280 609 005
WHATSAPP_API_TOKEN=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
ADMIN_NOTIFICATION_PHONE=916280609005

# Initial Super Admin Credentials (Created automatically on running `npm run seed`)
INITIAL_ADMIN_EMAIL=admin@architecturewonders.com
INITIAL_ADMIN_PASSWORD=StudioAW2026!
